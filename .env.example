# Example environment variables. Export these in your shell before running
# locally, or set them in the Render dashboard. Never commit real secrets.

# Stable signing key for sessions and CSRF tokens.
# If unset, the app generates one and stores it at .secret_key beside the
# SQLite database. render.yaml / render-free.yaml generate a stable value.
SECRET_KEY=replace-with-a-long-random-value

# SQLite file. On the paid Render Blueprint the disk is mounted at /var/data.
# On the free plan there is no disk, so omit DB_PATH (the file stays beside
# app.py and is lost on redeploy/restart).
DB_PATH=eclearance.db

# Timestamps for signatures.
APP_TIMEZONE=Asia/Manila

# "1" seeds the demo student/faculty accounts on an empty database.
# Set to 0 for a real install, then create accounts with:
#   flask --app app create-user --role faculty ...
SEED_DEMO_ACCOUNTS=1

# Optional: enables faculty self-registration and requires this access code.
# Left blank on Render, faculty registration is closed.
FACULTY_SIGNUP_CODE=

# Optional: set to 0 if you serve the app over plain HTTP locally.
# Defaults to 1 in production (Render) and 0 locally.
# SESSION_COOKIE_SECURE=0
